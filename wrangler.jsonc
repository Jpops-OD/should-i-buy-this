{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "should-i-buy-this",
  "main": "src/index.js",
  "compatibility_date": "2026-08-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "vars": { "APP_ENV": "production" }
}
