{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "should-i-buy-this",
  "main": "worker/phase4.ts",
  "compatibility_date": "2026-08-02",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
